# Public values shared by the three frontends
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
API_BASE_URL=https://api.ranyechai.site
MEDIA_PUBLIC_BASE_URL=https://media.ranyechai.site

# Worker secrets: configure with `wrangler secret put`, never expose to a frontend
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
TURNSTILE_SECRET_KEY=REPLACE_ME

